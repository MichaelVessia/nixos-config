 import { check, pluginIntact, readJson, tempBeside } from "./common.mjs";
@@ -41,6 +41,11 @@
   // and files a release dropped do not linger.
   const fresh = tempBeside(path);
   cpSync(pluginRoot, fresh, { recursive: true });
+  // Store directories are read-only. Make the copy removable on the next update.
+  chmodSync(fresh, 0o700);
+  for (const entry of readdirSync(fresh, { recursive: true, withFileTypes: true })) {
