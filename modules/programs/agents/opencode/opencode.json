{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5-fast",
  "providers": {
    "openai": {
      "models": {
        "gpt-5.5-fast": {
          "settings": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "executor": {
        "type": "remote",
        "url": "{env:OPENCODE_EXECUTOR_URL}"
      }
    }
  }
}
