{
  // Directory containing specs/plans/tasks in markdown.
  "specsDir": "docs/prds",

  // Claude model alias/name.
  "model": "opus",

  // Claude effort variant: low | medium | high | default.
  "variant": "medium",

  // Prefix for auto-loop commits.
  "commitPrefix": "feat(ralph-auto/claude)",

  // Required CI checks run after each TASK_COMPLETE signal.
  // Replace with your project commands.
  "checks": [
    {
      "name": "Quality checks",
      "command": "./ralph/scripts/ci-check.sh"
    }
  ],

  // Optional command reference shown in prompt.
  "commands": [
    {
      "name": "Run Claude auto loop",
      "command": "./ralph/ralph-auto-claude.sh \"implement <topic>\""
    }
  ]
}
