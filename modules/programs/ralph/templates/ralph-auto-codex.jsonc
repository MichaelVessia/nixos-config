{
  // Directory containing specs/plans/tasks in markdown.
  "specsDir": "docs/prds",

  // Codex model name.
  "model": "gpt-5-codex",

  // Codex profile variant from ~/.codex/config.toml (or "default").
  "variant": "default",

  // Prefix for auto-loop commits.
  "commitPrefix": "feat(ralph-auto/codex)",

  // Required CI checks run after each TASK_COMPLETE signal.
  // Replace with your project commands.
  "checks": [
    {
      "name": "Quality checks",
      "command": "./ralph/scripts/ci-check.sh"
    }
  ],

  // Optional command reference shown in prompt.
  "commands": [
    {
      "name": "Run Codex auto loop",
      "command": "./ralph/ralph-auto-codex.sh \"implement <topic>\""
    }
  ]
}
