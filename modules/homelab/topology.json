{
  "network": {
    "domain": "lan",
    "lanSubnet": "192.168.1.0/24",
    "iotSubnet": "192.168.3.0/24",
    "gateway": "192.168.1.1",
    "otlpAllowlist": [
      "192.168.1.18",
      "192.168.1.24",
      "192.168.1.105",
      "192.168.1.221",
      "192.168.1.247"
    ]
  },
  "nas": {
    "ip": "192.168.1.176",
    "mounts": {
      "media": {
        "export": "/volume1/nfs_media",
        "mountPoint": "/mnt/synology-media",
        "readOnly": false
      },
      "photo": {
        "export": "/volume1/photo",
        "mountPoint": "/mnt/synology-photo",
        "readOnly": true
      },
      "photoUpload": {
        "export": "/volume1/nfs_immich_uploads",
        "mountPoint": "/mnt/synology-photo-upload",
        "readOnly": false
      },
      "calibreLibrary": {
        "export": "/volume1/Books",
        "mountPoint": "/mnt/synology-calibre-library",
        "readOnly": false
      }
    },
    "backupMount": {
      "export": "/volume1/Backups",
      "mountPoint": "/mnt/synology-backups",
      "readOnly": false,
      "b2Replicated": true
    }
  },
  "services": {
    "caddy": {
      "port": 80,
      "httpsPort": 443,
      "adminPort": 2019,
      "bind": "lan",
      "domains": ["caddy.lan"],
      "owner": "nixos",
      "milestone": "M6"
    },
    "adguard": {
      "port": 3053,
      "dnsPort": 53,
      "bind": "lan",
      "domains": ["adguard.lan"],
      "owner": "nixos",
      "milestone": "M6"
    },
