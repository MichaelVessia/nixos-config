#!/usr/bin/env bash
set -e
set -u
set -o pipefail

# Deploy every host this machine may reach (the "from-<host>" groups in
# deploy.nodes in flake.nix), then apply this machine. Each host first runs the
# new configuration with --test (no boot loader change). One prompt then
# approves the persistent switch. Hosts are independent, so a failed host does
# not roll back the others; each still rolls itself back.
CONFIG_DIR="${NIXOS_CONFIG:-$HOME/nixos-config}"
HOSTNAME=$(hostname -s)

# Darwin cannot build Linux closures, so the targets build them.
build_args=()
if [ "$(uname -s)" = Darwin ]; then
  build_args=(--remote-build)
fi

cd "$CONFIG_DIR"
deploy_group() {
  nix develop --command deploy -s . --groups "from-$HOSTNAME" \
    --rollback-succeeded false ${build_args[@]+"${build_args[@]}"} "$@"
}

echo "Testing hosts in group from-$HOSTNAME..."
deploy_group --test

read -r -p "Switch hosts in group from-$HOSTNAME and apply $HOSTNAME? [y/N] " answer
case "$answer" in
y | Y) ;;
*)
  echo "Stopped. Tested configurations stay active until the next reboot."
  exit 1
  ;;
esac

echo "Switching hosts in group from-$HOSTNAME..."
deploy_group

echo "Applying $HOSTNAME..."
reload
