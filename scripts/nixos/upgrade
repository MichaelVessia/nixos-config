#!/usr/bin/env bash
set -e
set -u
set -o pipefail

# Use NIXOS_CONFIG env var, fallback to default location
CONFIG_DIR="${NIXOS_CONFIG:-$HOME/nixos-config}"

# Get hostname for flake selector
HOSTNAME=$(hostname -s)

# Detect platform and run appropriate rebuild command
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS with nix-darwin (requires sudo). Prefer a host-local flake when
    # present so private host-only inputs (for example floai on flomac) do not
    # affect the root flake used by Linux hosts.
    HOST_FLAKE_DIR="$CONFIG_DIR/hosts/$HOSTNAME"
    if [[ -f "$HOST_FLAKE_DIR/flake.nix" ]]; then
        FLAKE_DIR="$HOST_FLAKE_DIR"
    else
        FLAKE_DIR="$CONFIG_DIR"
    fi

    echo "Updating flake inputs in $FLAKE_DIR..."
    cd "$FLAKE_DIR"
    nix flake update

    echo "Rebuilding nix-darwin configuration for $HOSTNAME..."
    sudo darwin-rebuild switch --flake "$FLAKE_DIR#$HOSTNAME"
else
    # NixOS
    echo "Updating flake inputs in $CONFIG_DIR..."
    cd "$CONFIG_DIR"
    nix flake update

    echo "Rebuilding NixOS configuration for $HOSTNAME..."
    sudo nixos-rebuild switch --flake "$CONFIG_DIR#$HOSTNAME"
fi
