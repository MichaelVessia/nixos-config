#!/usr/bin/env bash
# TTS script - sends announcements via Home Assistant
# Usage: tts "message" [speaker]
# Speakers: living-room (default), backyard, garage, all

set -e

source ~/.secrets.env

MESSAGE="${1:-}"
SPEAKER="${2:-living-room}"

if [[ -z "$MESSAGE" ]]; then
  echo "Usage: tts \"message\" [speaker]"
  echo "Speakers: living-room (default), backyard, garage, all"
  exit 1
fi

if [[ -z "$HA_TOKEN" ]]; then
  echo "Error: HA_TOKEN not set in ~/.secrets.env"
  exit 1
fi

# Get current values to restore later
ORIGINAL_SPEAKER=$(curl -s \
  -H "Authorization: Bearer $HA_TOKEN" \
  "$HA_URL/api/states/input_select.tts_speaker" | jq -r '.state')

ORIGINAL_ONKYO_SOURCE=$(curl -s \
  -H "Authorization: Bearer $HA_TOKEN" \
  "$HA_URL/api/states/media_player.tx_nr595" | jq -r '.attributes.source')

# Map speaker argument to input_select value
case "$SPEAKER" in
living-room | living | lr)
  SPEAKER_VALUE="Living Room"
  ;;
backyard | back | by)
  SPEAKER_VALUE="Backyard"
  ;;
garage | gar)
  SPEAKER_VALUE="Garage"
  ;;
all)
  SPEAKER_VALUE="All Zones"
  ;;
*)
  echo "Unknown speaker: $SPEAKER"
  echo "Valid options: living-room, backyard, garage, all"
  exit 1
  ;;
esac

# Set the speaker
curl -s -X POST \
  -H "Authorization: Bearer $HA_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"entity_id\": \"input_select.tts_speaker\", \"option\": \"$SPEAKER_VALUE\"}" \
  "$HA_URL/api/services/input_select/select_option" >/dev/null

# Set the message
curl -s -X POST \
  -H "Authorization: Bearer $HA_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"entity_id\": \"input_text.tts_message\", \"value\": \"$MESSAGE\"}" \
  "$HA_URL/api/services/input_text/set_value" >/dev/null

# Trigger the script
curl -s -X POST \
  -H "Authorization: Bearer $HA_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"entity_id\": \"script.send_custom_tts\"}" \
  "$HA_URL/api/services/script/turn_on" >/dev/null

echo "TTS sent to $SPEAKER_VALUE: $MESSAGE"

# Wait for TTS script to complete
while true; do
  SCRIPT_STATE=$(curl -s \
    -H "Authorization: Bearer $HA_TOKEN" \
    "$HA_URL/api/states/script.send_custom_tts" | jq -r '.state')
  if [[ "$SCRIPT_STATE" == "off" ]]; then
    break
  fi
  sleep 1
done

# Restore original values
if [[ -n "$ORIGINAL_SPEAKER" && "$ORIGINAL_SPEAKER" != "null" ]]; then
  curl -s -X POST \
    -H "Authorization: Bearer $HA_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{\"entity_id\": \"input_select.tts_speaker\", \"option\": \"$ORIGINAL_SPEAKER\"}" \
    "$HA_URL/api/services/input_select/select_option" >/dev/null
fi

if [[ -n "$ORIGINAL_ONKYO_SOURCE" && "$ORIGINAL_ONKYO_SOURCE" != "null" ]]; then
  curl -s -X POST \
    -H "Authorization: Bearer $HA_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{\"entity_id\": \"media_player.tx_nr595\", \"source\": \"$ORIGINAL_ONKYO_SOURCE\"}" \
    "$HA_URL/api/services/media_player/select_source" >/dev/null
fi
